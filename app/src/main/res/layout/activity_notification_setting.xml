<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_setting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFEFD">

    <!-- 상단 앱 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#FFFEFD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:padding="12dp"
            android:src="@drawable/ic_mypage_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:gravity="center"
            android:text="알림 설정"
            android:textColor="#1E1E1E"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 서비스 알림 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="서비스 알림"
                    android:textColor="#1E1E1E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 예약 알림 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_reservation_notification"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/tv_reservation_notification_title"
                        android:layout_width="0dp"
                        android:layout_height="27dp"
                        android:gravity="center_vertical"
                        android:text="예약 알림"
                        android:textColor="#1E1E1E"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switch_reservation_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="예약 확정 및 방문 전 필요한 정보를 안내해 드려요."
                        android:textColor="#64605D"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_reservation_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_reservation_notification_title" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_reservation_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:contentDescription="예약 알림 설정"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 견적 알림 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_estimate_notification"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_estimate_notification_title"
                        android:layout_width="0dp"
                        android:layout_height="27dp"
                        android:gravity="center_vertical"
                        android:text="견적 알림"
                        android:textColor="#1E1E1E"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switch_estimate_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="견적에 대한 응답이 오는 대로 안내해 드려요."
                        android:textColor="#64605D"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_estimate_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_estimate_notification_title" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_estimate_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:contentDescription="견적 알림 설정"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- 영역 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#F2F0EE" />

            <!-- 광고성 정보 알림 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="16dp"
                android:paddingBottom="36dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:gravity="center_vertical"
                        android:text="광고성 정보 알림"
                        android:textColor="#1E1E1E"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/tv_ad_terms"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_ad_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="약관 보기"
                        android:textColor="#A96078"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 전체 광고 알림 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_all_ad_notification"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="전체 알림 받기"
                        android:textColor="#1E1E1E"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switch_all_ad_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_all_ad_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="false"
                        android:contentDescription="전체 광고 알림 설정"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 푸시 알림 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_push_notification"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:alpha="0.6">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="푸시알림"
                        android:textColor="#64605D"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switch_push_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_push_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="false"
                        android:contentDescription="광고 푸시 알림 설정"
                        android:enabled="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- SNS -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_sns_notification"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:alpha="0.6">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="SNS"
                        android:textColor="#64605D"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switch_sns_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_sns_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="false"
                        android:contentDescription="광고 SNS 알림 설정"
                        android:enabled="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 이메일 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_email_notification"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:alpha="0.6">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="이메일"
                        android:textColor="#64605D"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switch_email_notification"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_email_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="false"
                        android:contentDescription="광고 이메일 알림 설정"
                        android:enabled="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:useMaterialThemeColors="false" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>