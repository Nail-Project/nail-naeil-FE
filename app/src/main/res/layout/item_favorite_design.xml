<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_favorite_design_item"
    android:layout_width="match_parent"
    android:layout_height="208dp"
    android:layout_margin="3dp"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 네일 이미지 -->
            <ImageView
                android:id="@+id/iv_design_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="찜한 네일 디자인"
                android:scaleType="centerCrop" />

            <!-- 이미지 아래쪽 그라데이션 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_favorite_design_gradient" />

            <!-- 상담폭주 배지 -->
            <TextView
                android:id="@+id/tv_popular_badge"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_favorite_design_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="상담폭주"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 하트 -->
            <ImageView
                android:id="@+id/iv_favorite_heart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="찜 해제"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_favorite_heart_white" />

            <!-- 디자인명 -->
            <TextView
                android:id="@+id/tv_design_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="도트 프렌치 네일"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>