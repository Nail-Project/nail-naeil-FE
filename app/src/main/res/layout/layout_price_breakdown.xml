<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1. 기본 가격 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="기본 가격"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvBasePriceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="35,000원"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/tvBasePriceItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="손 젤"
            android:textColor="#666666"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvBasePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="35,000원"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 2. 디자인 추가 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="디자인 추가"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvDesignPriceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="30,000원"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/tvDesignPriceItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="아트 추가 (10)"
            android:textColor="#666666"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvDesignPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="30,000원"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 3. 옵션 추가 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="옵션 추가"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvOptionPriceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="15,000원"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/tvOptionItem1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="파츠 추가 (2)"
            android:textColor="#666666"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvOptionPrice1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="10,000원"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/tvOptionItem2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="무광 추가"
            android:textColor="#666666"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvOptionPrice2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="5,000원"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="20dp" />

    <!-- 최종 예상 금액 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="최종 예상 금액"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvFinalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="66,500원"
            android:textColor="#996677"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>