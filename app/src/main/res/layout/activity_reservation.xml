<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reservation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <!-- 화면 제목 -->
    <TextView
        android:id="@+id/tv_reservation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="예약"
        android:textColor="#111111"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_reservation_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="예약된 시술 일정을 확인하세요"
        android:textColor="#858585"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tv_reservation_title"
        app:layout_constraintTop_toBottomOf="@id/tv_reservation_title" />

    <!-- 예약 탭 -->
    <LinearLayout
        android:id="@+id/layout_reservation_tabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reservation_description">

        <TextView
            android:id="@+id/tv_confirmed_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="확정된 예약"
            android:textColor="#FF5F8F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_past_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="지난 예약"
            android:textColor="#999999"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- 탭 아래 선택 표시선 -->
    <LinearLayout
        android:id="@+id/layout_tab_indicators"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_reservation_tabs">

        <View
            android:id="@+id/view_confirmed_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FF5F8F" />

        <View
            android:id="@+id/view_past_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FF5F8F"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- 예약 내용 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_reservation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tab_indicators">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 예약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reservation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_reservation_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="D - 1"
                        android:textColor="#FF747D"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_shop_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="영찬 네일 강남점"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_reservation_status" />

                    <TextView
                        android:id="@+id/tv_reservation_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:00"
                        android:textColor="#111111"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_reservation_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2026-05-10"
                        android:textColor="#7D7D7D"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_reservation_time" />

                    <!-- 둥근 네일 이미지 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_nail_image"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_marginTop="22dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_shop_name">

                        <ImageView
                            android:id="@+id/iv_nail_design"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="예약한 네일 디자인"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_nail_04" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_shop_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="성수역 도보 5분"
                        android:textColor="#7D7D7D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/card_nail_image"
                        app:layout_constraintTop_toTopOf="@id/card_nail_image" />

                    <TextView
                        android:id="@+id/tv_service_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="5dp"
                        android:text="손 젤네일 제거 있음"
                        android:textColor="#7D7D7D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/card_nail_image"
                        app:layout_constraintTop_toBottomOf="@id/tv_shop_location" />

                    <TextView
                        android:id="@+id/tv_reservation_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:text="55,000원"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/card_nail_image"
                        app:layout_constraintTop_toBottomOf="@id/tv_service_option" />

                    <!-- 길 찾기 / 샵 문의 버튼 -->
                    <LinearLayout
                        android:id="@+id/layout_reservation_buttons"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_nail_image">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_find_route"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="길 찾기"
                            android:textAllCaps="false"
                            android:textColor="#777777"
                            android:textSize="14sp"
                            app:backgroundTint="#E9E9E9"
                            app:cornerRadius="24dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_contact_shop"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="샵 문의"
                            android:textAllCaps="false"
                            android:textColor="#777777"
                            android:textSize="14sp"
                            app:backgroundTint="#E9E9E9"
                            app:cornerRadius="24dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_manage_reservation"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="예약 취소 및 변경"
                        android:textColor="#7D7D7D"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_reservation_buttons" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 확정된 예약 안내 -->
            <TextView
                android:id="@+id/tv_visit_notice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="24dp"
                android:text="방문 전 확인해주세요"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_visit_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:text="기존 젤 제거가 포함된 시술입니다. 예약 시간보다 10분 일찍 방문해 주시면 더욱 원활한 시술이 가능합니다."
                android:textColor="#858585"
                android:textSize="12sp" />

            <!-- 지난 예약 탭 안내 -->
            <TextView
                android:id="@+id/tv_past_reservation_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="최근 3개월간의 시술 내역입니다"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 하단 내비게이션 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="92dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 홈 -->
            <LinearLayout
                android:id="@+id/layout_tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="홈"
                    android:src="@drawable/ic_tab_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="홈"
                    android:textColor="#B5B2B4"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 견적함 -->
            <LinearLayout
                android:id="@+id/layout_tab_estimate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="견적함"
                    android:src="@drawable/ic_tab_list" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="견적함"
                    android:textColor="#B5B2B4"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 예약 -->
            <LinearLayout
                android:id="@+id/layout_tab_reservation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="예약"
                    android:src="@drawable/ic_tab_reservation_selected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="예약"
                    android:textColor="#686668"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 마이 -->
            <LinearLayout
                android:id="@+id/layout_tab_my"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="마이"
                    android:src="@drawable/ic_tab_my" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="마이"
                    android:textColor="#B5B2B4"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>git status