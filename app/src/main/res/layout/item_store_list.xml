<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp"
    android:background="#FFFFFF">

    <!-- 기존 매장 썸네일 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_store_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_store_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#BDBDBD"/>
    </androidx.cardview.widget.CardView>

    <!-- 기존 매장 이름 -->
    <TextView
        android:id="@+id/tv_store_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="유네일"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/cv_store_image"
        app:layout_constraintTop_toTopOf="@id/cv_store_image"/>

    <!-- 기존 매장 주소 -->
    <TextView
        android:id="@+id/tv_store_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="서울 동작구 장승배기로10길 100"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_store_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintTop_toBottomOf="@id/tv_store_name"/>

    <!-- 기존 별점 아이콘 -->
    <ImageView
        android:id="@+id/iv_star"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@android:drawable/star_on"
        app:tint="#FFC107"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_store_name"
        app:layout_constraintTop_toBottomOf="@id/tv_store_address"/>

    <!-- 기존 별점 및 리뷰 수 -->
    <TextView
        android:id="@+id/tv_rating_review"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4.8 (312)"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/iv_star"
        app:layout_constraintTop_toTopOf="@id/iv_star"
        app:layout_constraintBottom_toBottomOf="@id/iv_star"/>

    <!-- 기존 오른쪽 화살표 -->
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_media_next"
        app:tint="#CCCCCC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- 기존 하단 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/cv_store_image"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- 🔴 여기서부터 새로 추가된 선택 모드용 오버레이 & 체크 아이콘 -->
    <View
        android:id="@+id/view_selection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="#FF7F50"
        android:visibility="gone"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>