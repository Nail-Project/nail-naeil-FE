<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_favorite_shop_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFEFD"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- 상담폭주 배지 -->
    <TextView
        android:id="@+id/tv_shop_popular_badge"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_favorite_shop_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="상담폭주"
        android:textColor="#A96078"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 매장명 -->
    <TextView
        android:id="@+id/tv_favorite_shop_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:text="유네일"
        android:textColor="#1E1E1E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 별점 / 후기 / 위치 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="#FFAA00"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tv_favorite_shop_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:text="4.8"
            android:textColor="#64605D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_favorite_shop_review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:text="(312)"
            android:textColor="#8A8581"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:text="·"
            android:textColor="#64605D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_favorite_shop_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:text="상도동"
            android:textColor="#64605D"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- 매장 사진 3개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_favorite_shop_first"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="매장 첫 번째 이미지"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_favorite_shop_second"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="매장 두 번째 이미지"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_favorite_shop_third"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="매장 세 번째 이미지"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 매장 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#E3DFDC" />

</LinearLayout>