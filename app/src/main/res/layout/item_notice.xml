<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_notice_item"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:background="#FFFEFD"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 공지 제목 -->
    <TextView
        android:id="@+id/tv_notice_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="[공지] 네일내일 서비스 이용약관 개정 안내"
        android:textColor="#1E1E1E"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/iv_notice_open"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <!-- 날짜 -->
    <TextView
        android:id="@+id/tv_notice_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:text="2026년 07월 01일"
        android:textColor="#686360"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@id/tv_notice_title"
        app:layout_constraintTop_toBottomOf="@id/tv_notice_title" />

    <!-- 이동 화살표 -->
    <ImageView
        android:id="@+id/iv_notice_open"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="공지사항 상세 보기"
        android:src="@drawable/ic_mypage_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#686360" />

</androidx.constraintlayout.widget.ConstraintLayout>