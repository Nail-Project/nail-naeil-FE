<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFEFD">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_my_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFEFD"
            android:orientation="vertical">

            <!-- 상단 제목 -->
            <TextView
                android:id="@+id/tv_my_page_title"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="마이"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 프로필 / 찜 메뉴 / 멤버십 -->
            <LinearLayout
                android:id="@+id/layout_main_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- 프로필 영역 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_profile"
                    android:layout_width="match_parent"
                    android:layout_height="67dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- 프로필 이미지 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_profile_image"
                        android:layout_width="67dp"
                        android:layout_height="67dp"
                        app:cardCornerRadius="34dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/iv_profile_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="프로필 이미지"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_profile" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 닉네임과 활동 수 -->
                    <LinearLayout
                        android:id="@+id/layout_profile_text"
                        android:layout_width="0dp"
                        android:layout_height="59dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btn_profile_edit"
                        app:layout_constraintStart_toEndOf="@id/card_profile_image"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="33dp"
                            android:gravity="center_vertical"
                            android:text="네일내일"
                            android:textColor="#1E1E1E"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_activity_count"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:gravity="center_vertical"
                                android:text="진행중인 견적"
                                android:textColor="#64605D"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_estimate_count"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginStart="4dp"
                                android:gravity="center_vertical"
                                android:text="1"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginStart="12dp"
                                android:gravity="center_vertical"
                                android:text="시술예정 예약"
                                android:textColor="#64605D"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_reservation_count"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginStart="4dp"
                                android:gravity="center_vertical"
                                android:text="2"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 수정 버튼 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_profile_edit"
                        android:layout_width="47dp"
                        android:layout_height="29dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="수정"
                        android:textAllCaps="false"
                        android:textColor="#515151"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFEFD"
                        app:cornerRadius="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="#E3DFDC"
                        app:strokeWidth="1dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 찜한 디자인 / 찜한 매장 -->
                <LinearLayout
                    android:id="@+id/layout_favorite_menu"
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <!-- 찜한 디자인 -->
                    <LinearLayout
                        android:id="@+id/menu_favorite_design"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="찜한 디자인"
                            android:src="@drawable/icon_heart" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="찜한 디자인"
                            android:textColor="#64605D"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 가운데 구분선 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="#E3DFDC" />

                    <!-- 찜한 매장 -->
                    <LinearLayout
                        android:id="@+id/menu_favorite_shop"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="찜한 매장"
                            android:src="@drawable/icon_shop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="찜한 매장"
                            android:textColor="#64605D"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 무료 / N플러스 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_membership"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="36dp"
                    app:cardBackgroundColor="#FFFEFD"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#CFC9C5"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- 무료 이용 중 -->
                        <LinearLayout
                            android:id="@+id/layout_free_membership"
                            android:layout_width="match_parent"
                            android:layout_height="179dp"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- 무료 이용 제목 -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="27dp">

                                <TextView
                                    android:id="@+id/tv_free_membership_title"
                                    android:layout_width="0dp"
                                    android:layout_height="27dp"
                                    android:gravity="center_vertical"
                                    android:text="네일내일 무료 이용 중"
                                    android:textColor="#1E1E1E"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toStartOf="@id/tv_free_payment_history"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <!-- 결제내역 -->
                                <LinearLayout
                                    android:id="@+id/tv_free_payment_history"
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="22dp"
                                        android:gravity="center_vertical"
                                        android:text="결제내역"
                                        android:textColor="#8A8581"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="결제내역 이동"
                                        android:src="@drawable/ic_mypage_chevron_right"
                                        app:tint="#8A8581" />

                                </LinearLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <!-- 무료 이용 설명 -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:lineSpacingExtra="0dp"
                                android:text="N 플러스 플랜으로 업그레이드 시 더 많은 견적을 한 번에 받아볼 수 있어요!"
                                android:textColor="#64605D"
                                android:textSize="15sp" />

                            <!-- 더 많은 혜택 받기 -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_more_benefits"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="#A96078"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="26dp"
                                        android:gravity="center"
                                        android:text="더 많은 혜택 받기"
                                        android:textColor="#FAF9F8"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <!-- 흰색 원형 화살표 -->
                                    <FrameLayout
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_mypage_benefit_arrow_circle">

                                        <ImageView
                                            android:layout_width="12dp"
                                            android:layout_height="12dp"
                                            android:layout_gravity="center"
                                            android:contentDescription="혜택 화면 이동"
                                            android:src="@drawable/ic_mypage_chevron_right"
                                            app:tint="#A96078" />

                                    </FrameLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- N플러스 이용 중 -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_nplus_membership"
                            android:layout_width="match_parent"
                            android:layout_height="111dp"
                            android:padding="16dp"
                            android:visibility="gone">

                            <!-- N플러스 로고와 이용 중 -->
                            <LinearLayout
                                android:id="@+id/layout_nplus_title"
                                android:layout_width="wrap_content"
                                android:layout_height="27dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:id="@+id/iv_nplus_logo"
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:contentDescription="N플러스"
                                    android:src="@drawable/icon_logo" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="27dp"
                                    android:layout_marginStart="4dp"
                                    android:gravity="center_vertical"
                                    android:text="플러스"
                                    android:textColor="#A96078"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="27dp"
                                    android:layout_marginStart="8dp"
                                    android:gravity="center_vertical"
                                    android:text="이용 중"
                                    android:textColor="#1E1E1E"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- N플러스 결제내역 -->
                            <LinearLayout
                                android:id="@+id/tv_nplus_payment_history"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                app:layout_constraintBottom_toBottomOf="@id/layout_nplus_title"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/layout_nplus_title">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:gravity="center_vertical"
                                    android:text="결제내역"
                                    android:textColor="#8A8581"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="결제내역 이동"
                                    android:src="@drawable/ic_mypage_chevron_right"
                                    app:tint="#8A8581" />

                            </LinearLayout>

                            <!-- 가입 날짜 -->
                            <TextView
                                android:id="@+id/tv_nplus_join_date"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:text="요금제 가입일 2026-07-08"
                                android:textColor="#64605D"
                                android:textSize="15sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/layout_nplus_title" />

                            <!-- 월 요금 -->
                            <TextView
                                android:id="@+id/tv_nplus_price"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:gravity="center_vertical"
                                android:text="0원/월"
                                android:textColor="#1E1E1E"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 큰 영역 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#F2F0EE" />

            <!-- 설정 및 안내 -->
            <LinearLayout
                android:id="@+id/layout_setting_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="36dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="설정 및 안내"
                    android:textColor="#1E1E1E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 내 정보 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menu_my_info"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내 정보"
                        android:textColor="#1E1E1E"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="내 정보 이동"
                        android:src="@drawable/ic_mypage_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#64605D" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#E3DFDC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 알림 설정 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menu_notification_setting"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="알림 설정"
                        android:textColor="#1E1E1E"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="알림 설정 이동"
                        android:src="@drawable/ic_mypage_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#64605D" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#E3DFDC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 공지사항 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menu_notice"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="공지사항"
                        android:textColor="#1E1E1E"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="공지사항 이동"
                        android:src="@drawable/ic_mypage_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#64605D" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#E3DFDC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 약관 및 정책 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menu_terms_policy"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="약관 및 정책"
                        android:textColor="#1E1E1E"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="약관 및 정책 이동"
                        android:src="@drawable/ic_mypage_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#64605D" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 하단 내비게이션 위 구분선 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E3DFDC"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 하단 내비게이션 -->
    <LinearLayout
        android:id="@+id/layout_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#FFFEFD"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 홈 -->
        <LinearLayout
            android:id="@+id/nav_home"
